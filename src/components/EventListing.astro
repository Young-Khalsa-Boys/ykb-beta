---
const {
  eyebrow,
  title,
  intro,
  items = [],
  emptyMessage = 'More coming soon.',
} = Astro.props;
---

<div class="min-h-screen bg-[#FAF6EE]">

  <!-- PAGE INTRO -->
  <section class="border-b border-[#EADFC9] bg-[#FAF6EE]">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ykb-blue)] mb-4">
        {eyebrow}
      </p>

      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-[#2B2317] leading-[1.05]">
          {title}
        </h1>

        <p class="mt-6 max-w-2xl text-lg md:text-xl text-slate-600 leading-8">
          {intro}
        </p>
      </div>

    </div>
  </section>


  {
    items.length === 0 ? (
      <section class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-20">
        <div class="border-y border-[#EADFC9] py-16">
          <p class="text-center text-lg font-serif text-slate-500">
            {emptyMessage}
          </p>
        </div>
      </section>
    ) : (
      <section class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

        <div class="space-y-24">

          {items.map((item) => {
            const firstImage = item.images[0];
            const hasMultipleImages = item.images.length > 1;

            return (
              <article class="border-t border-[#EADFC9] pt-10 md:pt-12">

                <div class="grid lg:grid-cols-[1.35fr_0.65fr] gap-10 lg:gap-16 items-start">

                  <!-- PHOTOGRAPHY -->
                  <div
                    class="space-y-4"
                    data-event-carousel
                    data-images={JSON.stringify(item.images)}
                  >

                    {firstImage ? (
                      <div class="relative overflow-hidden bg-[#E7DED0]">

                        <img
                          src={firstImage.src}
                          alt={`${item.name} — Young Khalsa Boys`}
                          class="aspect-[16/10] w-full object-cover"
                          loading="lazy"
                          data-event-active-image
                        />

                        {hasMultipleImages && (
                          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between px-4 py-3 bg-[#19221C]/85 text-white">

                            <button
                              type="button"
                              class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/75 hover:text-white transition-colors"
                              data-event-prev
                            >
                              Previous
                            </button>

                            <span
                              class="text-xs font-semibold tabular-nums"
                              data-event-counter
                            >
                              1 / {item.images.length}
                            </span>

                            <button
                              type="button"
                              class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/75 hover:text-white transition-colors"
                              data-event-next
                            >
                              Next
                            </button>

                          </div>
                        )}

                      </div>
                    ) : (
                      <div class="aspect-[16/10] bg-[#E7DED0]"></div>
                    )}

                    {hasMultipleImages && (
                      <div class="flex gap-2 overflow-x-auto pb-1">

                        {item.images.map((image, index) => (
                          <button
                            type="button"
                            class:list={[
                              'h-16 w-24 flex-shrink-0 overflow-hidden border-2 transition-opacity',
                              index === 0
                                ? 'border-[var(--ykb-orange)]'
                                : 'border-transparent opacity-60 hover:opacity-100',
                            ]}
                            aria-label={`Show photo ${index + 1} for ${item.name}`}
                            data-event-thumb={index}
                          >
                            <img
                              src={image.src}
                              alt=""
                              class="h-full w-full object-cover"
                              loading="lazy"
                            />
                          </button>
                        ))}

                      </div>
                    )}

                  </div>


                  <!-- INFORMATION -->
                  <div class="lg:pt-1">

                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ykb-orange)] mb-5">
                      {item.category}
                    </p>

                    <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B2317] leading-tight">
                      {item.name}
                    </h2>


                    <!-- EVENT DETAILS -->
                    <dl class="mt-8 space-y-5">

                      <div>
                        <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                          Date
                        </dt>
                        <dd class="mt-1 text-sm font-semibold text-[#2B2317]">
                          {item.date}
                        </dd>
                      </div>

                      <div>
                        <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                          Location
                        </dt>
                        <dd class="mt-1 text-sm font-semibold text-[#2B2317]">
                          {item.location}
                        </dd>
                      </div>

                    </dl>


                    <!-- IMPACT -->
                    <div class="mt-9 border-l-2 border-[var(--ykb-orange)] pl-5">

                      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                        Impact
                      </p>

                      <p class="mt-2 text-lg font-serif font-bold leading-7 text-[#2B2317]">
                        {item.impact}
                      </p>

                    </div>


                    <p class="mt-9 text-base text-slate-600 leading-7">
                      {item.summary}
                    </p>

                  </div>

                </div>

              </article>
            );
          })}

        </div>

      </section>
    )
  }

</div>


<script>
  document.querySelectorAll('[data-event-carousel]').forEach((carousel) => {
    const images = JSON.parse(
      carousel.getAttribute('data-images') || '[]'
    );

    const activeImage = carousel.querySelector('[data-event-active-image]');
    const counter = carousel.querySelector('[data-event-counter]');
    const thumbs = [...carousel.querySelectorAll('[data-event-thumb]')];

    let activeIndex = 0;

    if (!activeImage || images.length < 2) {
      return;
    }

    const showImage = (nextIndex) => {
      activeIndex = (nextIndex + images.length) % images.length;

      activeImage.src = images[activeIndex].src;

      if (counter) {
        counter.textContent = `${activeIndex + 1} / ${images.length}`;
      }

      thumbs.forEach((thumb, index) => {
        thumb.classList.toggle(
          'border-[var(--ykb-orange)]',
          index === activeIndex
        );

        thumb.classList.toggle(
          'border-transparent',
          index !== activeIndex
        );

        thumb.classList.toggle(
          'opacity-60',
          index !== activeIndex
        );

        thumb.classList.toggle(
          'opacity-100',
          index === activeIndex
        );
      });
    };

    carousel
      .querySelector('[data-event-prev]')
      ?.addEventListener('click', () => {
        showImage(activeIndex - 1);
      });

    carousel
      .querySelector('[data-event-next]')
      ?.addEventListener('click', () => {
        showImage(activeIndex + 1);
      });

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        showImage(index);
      });
    });

    window.setInterval(() => {
      showImage(activeIndex + 1);
    }, 5000);
  });
</script>