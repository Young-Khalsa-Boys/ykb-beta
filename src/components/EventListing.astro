---
import { getImage } from 'astro:assets';

const {
  eyebrow,
  title,
  intro,
  items: rawItems = [],
  emptyMessage = 'More coming soon.',
} = Astro.props;

// Load all images in src/assets eagerly for directory processing
const allImagesGlob = import.meta.glob('/src/assets/**/*.{jpeg,jpg,png,webp,gif}', { eager: true });

// Process items to support directory loading (needs to be async due to getImage)
const items = await Promise.all(rawItems.map(async (item) => {
  let images = item.images || [];

  if (item.directory && images.length === 0) {
    const dirPrefix = `/src/assets${item.directory}`;
    
    // Find all images matching the directory prefix
    const matchingKeys = Object.keys(allImagesGlob)
      .filter(key => key.startsWith(dirPrefix))
      .sort((a, b) => a.localeCompare(b));
    
    if (matchingKeys.length === 0) {
      console.warn(`No images found for directory: ${item.directory}`);
    }
      
    // Optimize images for performance
    images = await Promise.all(matchingKeys.map(async (key) => {
      const originalImage = allImagesGlob[key].default;
      
      const optimizedMain = await getImage({
        src: originalImage,
        width: 1200,
        format: 'webp'
      });
      
      const optimizedThumb = await getImage({
        src: originalImage,
        width: 300,
        format: 'webp'
      });

      return {
        src: optimizedMain.src,
        thumb: optimizedThumb.src,
      };
    }));
  }
  
  return { ...item, images };
}));
---

<div class="min-h-screen bg-[#FAF6EE]">

  <!-- PAGE INTRO -->
  <section class="border-b border-[#EADFC9] bg-[#FAF6EE]">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-ykb-blue)] mb-4">
        {eyebrow}
      </p>

      <div class="max-w-4xl">
        <h1 class="text-4xl md:text-6xl font-serif font-bold text-[#2B2317] leading-[1.05]">
          {title}
        </h1>

        <p class="mt-6 max-w-2xl text-lg md:text-xl text-slate-600 leading-8">
          {intro}
        </p>
      </div>

      <!-- CHAPTER FILTER PILLS -->
      <div class="mt-8 flex flex-wrap gap-2.5" data-chapter-filter-group>
        <button
          type="button"
          data-filter="all"
          class="chapter-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 border bg-[#2B2317] text-white border-[#2B2317] shadow-sm"
        >
          All Chapters
        </button>
        <button
          type="button"
          data-filter="young-khalsa-boys"
          class="chapter-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 border bg-white/90 text-slate-700 border-[#EADFC9] hover:border-[var(--color-ykb-blue)] hover:text-[var(--color-ykb-blue)] shadow-sm"
        >
          Young Khalsa Boys
        </button>
        <button
          type="button"
          data-filter="ykb-south"
          class="chapter-filter-btn px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all duration-200 border bg-white/90 text-slate-700 border-[#EADFC9] hover:border-[var(--color-ykb-orange)] hover:text-[var(--color-ykb-orange)] shadow-sm"
        >
          YKB South
        </button>
      </div>

    </div>
  </section>


  {
    items.length === 0 ? (
      <section class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-20">
        <div class="border-y border-[#EADFC9] py-16">
          <p class="text-center text-lg font-serif text-slate-500">
            {emptyMessage}
          </p>
        </div>
      </section>
    ) : (
      <section class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

        <div class="space-y-24" id="event-list-container">

          {items.map((item) => {
            const images = item.images || [];
            const firstImage = images[0];
            const hasMultipleImages = images.length > 1;
            const chapter = item.chapter || 'Young Khalsa Boys';
            const chapterSlug = chapter.toLowerCase().includes('south') ? 'ykb-south' : 'young-khalsa-boys';

            return (
              <article
                class="border-t border-[#EADFC9] pt-10 md:pt-12 transition-opacity duration-200"
                data-event-item
                data-chapter={chapterSlug}
              >

                <div class="grid lg:grid-cols-[1.35fr_0.65fr] gap-10 lg:gap-16 items-start">

                  <!-- PHOTOGRAPHY -->
                  <div
                    class="space-y-4 min-w-0"
                    data-event-carousel
                    data-images={JSON.stringify(images)}
                  >

                    {firstImage ? (
                      <div class="relative overflow-hidden bg-[#E7DED0]">

                        <img
                          src={firstImage.src}
                          alt={`${item.name} — Young Khalsa Boys`}
                          class="aspect-[16/10] w-full object-contain"
                          loading="lazy"
                          data-event-active-image
                        />

                        {hasMultipleImages && (
                          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between px-4 py-3 bg-[#19221C]/85 text-white">

                            <button
                              type="button"
                              class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/75 hover:text-white transition-colors"
                              data-event-prev
                            >
                              Previous
                            </button>

                            <span
                              class="text-xs font-semibold tabular-nums"
                              data-event-counter
                            >
                              1 / {images.length}
                            </span>

                            <button
                              type="button"
                              class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/75 hover:text-white transition-colors"
                              data-event-next
                            >
                              Next
                            </button>

                          </div>
                        )}

                      </div>
                    ) : (
                      <div class="aspect-[16/10] bg-[#E7DED0]"></div>
                    )}

                    {hasMultipleImages && (
                      <div class="flex gap-2 overflow-x-auto pb-1">

                        {images.map((image, index) => (
                          <button
                            type="button"
                            class:list={[
                              'h-16 w-24 flex-shrink-0 overflow-hidden border-2 transition-opacity',
                              index === 0
                                ? 'border-[var(--color-ykb-orange)]'
                                : 'border-transparent opacity-60 hover:opacity-100',
                            ]}
                            aria-label={`Show photo ${index + 1} for ${item.name}`}
                            data-event-thumb={index}
                          >
                            <img
                              src={image.thumb || image.src}
                              alt=""
                              class="h-full w-full object-contain"
                              loading="lazy"
                            />
                          </button>
                        ))}

                      </div>
                    )}

                  </div>


                  <!-- INFORMATION -->
                  <div class="lg:pt-1 min-w-0">

                    <!-- Chapter & Category Badges -->
                    <div class="flex flex-wrap items-center gap-2.5 mb-3">
                      <span class:list={[
                        'inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider',
                        chapterSlug === 'ykb-south'
                          ? 'bg-orange-100 text-[var(--color-ykb-orange)]'
                          : 'bg-blue-100 text-[var(--color-ykb-blue)]'
                      ]}>
                        {chapter}
                      </span>

                      <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
                        • {item.category}
                      </span>
                    </div>

                    <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B2317] leading-tight">
                      {item.name}
                    </h2>


                    <!-- EVENT DETAILS -->
                    <dl class="mt-8 space-y-5">

                      <div>
                        <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                          Date
                        </dt>
                        <dd class="mt-1 text-sm font-semibold text-[#2B2317]">
                          {item.date}
                        </dd>
                      </div>

                      <div>
                        <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                          Location
                        </dt>
                        <dd class="mt-1 text-sm font-semibold text-[#2B2317]">
                          {item.location}
                        </dd>
                      </div>

                      {item.impact && (
                        <div>
                          <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                            Impact
                          </dt>
                          <dd class="mt-1 text-sm font-semibold text-[#2B2317]">
                            {item.impact}
                          </dd>
                        </div>
                      )}

                      {item.summary && (
                        <div>
                          <dt class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">
                            Summary
                          </dt>
                          <dd class="mt-1 text-sm text-slate-600 leading-6">
                            {item.summary}
                          </dd>
                        </div>
                      )}

                    </dl>

                  </div>

                </div>

              </article>
            );
          })}

        </div>

        <div id="no-matching-events" class="hidden border-y border-[#EADFC9] py-16 text-center">
          <p class="text-lg font-serif text-slate-500">
            No events found for this chapter yet. More coming soon!
          </p>
        </div>

      </section>
    )
  }

</div>

<script>
  // Chapter Filter Functionality
  const filterButtons = document.querySelectorAll('.chapter-filter-btn');
  const eventItems = document.querySelectorAll('[data-event-item]');
  const noMatchNotice = document.getElementById('no-matching-events');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter');

      // Update button styling
      filterButtons.forEach((b) => {
        const isCurrent = b === btn;
        b.classList.toggle('bg-[#2B2317]', isCurrent);
        b.classList.toggle('text-white', isCurrent);
        b.classList.toggle('border-[#2B2317]', isCurrent);
        b.classList.toggle('bg-white/90', !isCurrent);
        b.classList.toggle('text-slate-700', !isCurrent);
        b.classList.toggle('border-[#EADFC9]', !isCurrent);
      });

      let visibleCount = 0;
      eventItems.forEach((item) => {
        const itemChapter = item.getAttribute('data-chapter');
        const matches = selected === 'all' || itemChapter === selected;
        if (matches) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (noMatchNotice) {
        noMatchNotice.classList.toggle('hidden', visibleCount > 0);
      }
    });
  });

  // Photo Carousel Functionality
  document.querySelectorAll('[data-event-carousel]').forEach((carousel) => {
    const rawImages = carousel.getAttribute('data-images');
    const images = rawImages ? JSON.parse(rawImages) : [];
    const activeImage = carousel.querySelector('[data-event-active-image]');
    const counter = carousel.querySelector('[data-event-counter]');
    const thumbs = carousel.querySelectorAll('[data-event-thumb]');
    let activeIndex = 0;

    if (!activeImage || images.length < 2) {
      return;
    }

    const showImage = (nextIndex) => {
      activeIndex = (nextIndex + images.length) % images.length;

      activeImage.src = images[activeIndex].src;

      if (counter) {
        counter.textContent = `${activeIndex + 1} / ${images.length}`;
      }

      thumbs.forEach((thumb, index) => {
        thumb.classList.toggle(
          'border-[var(--color-ykb-orange)]',
          index === activeIndex
        );

        thumb.classList.toggle(
          'border-transparent',
          index !== activeIndex
        );

        thumb.classList.toggle(
          'opacity-60',
          index !== activeIndex
        );

        thumb.classList.toggle(
          'opacity-100',
          index === activeIndex
        );
      });
    };

    carousel
      .querySelector('[data-event-prev]')
      ?.addEventListener('click', () => {
        showImage(activeIndex - 1);
      });

    carousel
      .querySelector('[data-event-next]')
      ?.addEventListener('click', () => {
        showImage(activeIndex + 1);
      });

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => {
        showImage(index);
      });
    });

    window.setInterval(() => {
      showImage(activeIndex + 1);
    }, 5000);
  });
</script>
