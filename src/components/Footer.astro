---
const year = new Date().getFullYear();
---

<footer class="bg-[#19221C] text-[#D4CDC3] mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Main Footer -->
    <div class="py-14 md:py-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

      <!-- Brand -->
      <div class="lg:col-span-7">
        <a href="/" class="inline-flex items-center gap-3 group">
          <img
            src="/logo.png"
            alt="Young Khalsa Boys"
            class="h-11 w-auto opacity-90 group-hover:opacity-100 transition-opacity"
          />

          <span class="font-serif font-bold text-xl text-white">
            Young Khalsa Boys
          </span>
        </a>

        <p class="mt-5 max-w-lg text-[15px] leading-7 text-[#D4CDC3]/65">
          Empowering Sikh boys to grow into compassionate leaders through
          boy-led community service, seva, and meaningful action.
        </p>

        <nav class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a href="/about" class="hover:text-white transition-colors">About</a>
          <span class="text-[#D4CDC3]/20">/</span>
          <a href="/projects" class="hover:text-white transition-colors">Projects</a>
          <span class="text-[#D4CDC3]/20">/</span>
          <a href="/fundraisers" class="hover:text-white transition-colors">Fundraisers</a>
          <span class="text-[#D4CDC3]/20">/</span>
          <a href="/members" class="hover:text-white transition-colors">Members</a>
        </nav>
      </div>

      <!-- Support -->
      <div class="lg:col-span-5 lg:flex lg:justify-end">
        <div class="max-w-sm">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#D4CDC3]/40">
            Support Our Seva
          </p>

          <h2 class="mt-3 font-serif text-2xl text-white">
            Help us keep serving.
          </h2>

          <p class="mt-3 text-sm leading-6 text-[#D4CDC3]/60">
            Support the work of Young Khalsa Boys and help us create more
            opportunities for youth-led seva.
          </p>

          <a
            href="https://givebutter.com/young-khalsa-boys-fundraiser-bq2wmc"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 bg-[var(--ykb-orange)] hover:bg-orange-600 text-white text-sm font-bold rounded transition-colors"
          >
            Donate to YKB
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Footer Meta -->
    <div class="border-t border-[#2d3a30] py-6">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

        <!-- Legal -->
        <p class="text-[11px] leading-5 text-[#D4CDC3]/40 max-w-xl">
          &copy; {year} Young Khalsa Boys. Registered under Young Khalsa Boys
          Incorporated, a 501(c)(3) nonprofit. All rights reserved.
        </p>

        <!-- Credits -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">

          <span class="text-[#D4CDC3]/35">
            Built & maintained by
            <a
              href="https://kabirsekhon.youngkhalsaboys.com"
              class="font-semibold text-[#D4CDC3]/60 hover:text-[#D4CDC3] transition-colors"
            >
              Kabir Sekhon
            </a>
          </span>

          <span class="text-[#D4CDC3]/15">•</span>

          <a
            href="https://opensource.youngkhalsaboys.com"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-[#D4CDC3]/40 hover:text-[#D4CDC3]/70 transition-colors"
          >
            opensource.youngkhalsaboys.com
          </a>

        </div>
      </div>
    </div>

  </div>
</footer>