---
import '../index.css';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#19221C" />
    <meta name="description" content="The page you're looking for doesn't exist." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Page Not Found - Young Khalsa Boys</title>
  </head>

  <body class="min-h-screen bg-[#FAF6EE] antialiased">

    <div class="min-h-screen flex flex-col">

      <div class="flex-1 flex flex-col items-center justify-center px-6 sm:px-10">

        <!-- Logo -->
        <a href="/" class="group flex items-center gap-4 mb-16">
          <img
            src="/logo.png"
            alt=""
            width="56"
            height="56"
            style="width: 56px; height: 56px;"
            class="object-contain transition-transform duration-300 group-hover:scale-105"
          />
          <span class="font-serif text-2xl font-bold tracking-tight text-[#2B2317]">
            Young Khalsa Boys
          </span>
        </a>

        <!-- Big 404 number -->
        <p
          class="font-serif font-bold tracking-tighter text-[#EADFC9] select-none"
          style="font-size: clamp(10rem, 25vw, 22rem); line-height: 0.85;"
        >
          404
        </p>

        <!-- Label -->
        <p
          class="font-bold uppercase text-[var(--color-ykb-orange)]"
          style="font-size: 0.875rem; letter-spacing: 0.2em; margin-top: 2.5rem;"
        >
          Page Not Found
        </p>

        <!-- Description -->
        <p
          class="text-slate-500 text-center"
          style="font-size: 1.25rem; line-height: 1.7; margin-top: 1.5rem; max-width: 28rem;"
        >
          The page you're looking for doesn't exist or has been moved.
        </p>

        <!-- CTA Button -->
        <a
          href="/"
          class="inline-flex items-center bg-[var(--color-ykb-orange)] hover:bg-orange-600 text-white font-bold rounded-md shadow-sm transition-all duration-200 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[var(--color-ykb-orange)]/40"
          style="font-size: 1rem; padding: 0.875rem 2rem; gap: 0.625rem; margin-top: 2.5rem;"
        >
          Back to Home
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>

        <!-- Nav links -->
        <nav
          class="flex flex-wrap items-center justify-center font-medium"
          style="margin-top: 4rem; gap: 0.5rem 1rem;"
        >
          <a href="/about" class="text-slate-400 hover:text-[var(--color-ykb-blue)] transition-colors duration-200" style="font-size: 0.9375rem; padding: 0.375rem 0.5rem;">About</a>
          <span class="text-[#EADFC9]" style="font-size: 0.875rem;">•</span>
          <a href="/projects" class="text-slate-400 hover:text-[var(--color-ykb-blue)] transition-colors duration-200" style="font-size: 0.9375rem; padding: 0.375rem 0.5rem;">Projects</a>
          <span class="text-[#EADFC9]" style="font-size: 0.875rem;">•</span>
          <a href="/fundraisers" class="text-slate-400 hover:text-[var(--color-ykb-blue)] transition-colors duration-200" style="font-size: 0.9375rem; padding: 0.375rem 0.5rem;">Fundraisers</a>
          <span class="text-[#EADFC9]" style="font-size: 0.875rem;">•</span>
          <a href="/members" class="text-slate-400 hover:text-[var(--color-ykb-blue)] transition-colors duration-200" style="font-size: 0.9375rem; padding: 0.375rem 0.5rem;">Members</a>
        </nav>

      </div>

      <!-- Footer -->
      <div style="padding: 1.5rem 0;" class="text-center">
        <p class="text-slate-400" style="font-size: 0.6875rem; opacity: 0.6;">
          &copy; 2026 Young Khalsa Boys Incorporated
        </p>
      </div>

    </div>

  </body>
</html>
