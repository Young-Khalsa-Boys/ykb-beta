---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Donate - Young Khalsa Boys">
  <div class="min-h-screen bg-[#FAF6EE]">

    <!-- INTRO -->
    <section class="border-b border-[#EADFC9]">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-ykb-orange)] mb-4">
          Support Seva
        </p>

        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-6xl font-serif font-bold text-[#2B2317] leading-[1.05]">
            Empower the Next Generation
          </h1>

          <p class="mt-6 text-lg md:text-xl text-slate-600 leading-8 max-w-2xl">
            Every donation directly funds boy-led community service, food distributions,
            and youth leadership initiatives. Choose a chapter below to support their seva.
          </p>
        </div>

      </div>
    </section>

    <!-- CHAPTER DONATION CARDS -->
    <section class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

      <div class="grid md:grid-cols-2 gap-8 lg:gap-10">

        <!-- CARD 1: YOUNG KHALSA BOYS -->
        <div class="bg-white rounded-lg border border-[#EADFC9] p-8 md:p-10 flex flex-col justify-between shadow-sm hover:border-[var(--color-ykb-blue)] transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-100 text-[var(--color-ykb-blue)]">
                Headquarters / North
              </span>
              <span class="text-xs font-semibold text-slate-400">NJ & Surrounding</span>
            </div>

            <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#2B2317]">
              Young Khalsa Boys
            </h2>

            <p class="mt-4 text-slate-600 leading-7 text-sm md:text-base">
              Supports grassroots projects including <strong class="text-[#2B2317]">Langar in the Streets</strong>,
              community food drives with the Salvation Army, car wash seva fundraisers, and youth mentorship.
            </p>

            <ul class="mt-6 space-y-2.5 text-xs text-slate-600 font-medium border-t border-[#F2ECE1] pt-5">
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-ykb-blue)] font-bold">✓</span> Direct community food distribution
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-ykb-blue)] font-bold">✓</span> Youth leadership and seva workshops
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-ykb-blue)] font-bold">✓</span> 100% volunteer and youth driven
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-[#F2ECE1]">
            <a
              href="https://givebutter.com/young-khalsa-boys-fundraiser-bq2wmc"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 rounded-md bg-[var(--color-ykb-orange)] px-6 py-3.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-ykb-orange/40"
            >
              Donate to Young Khalsa Boys
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- CARD 2: YKB SOUTH -->
        <div class="bg-white rounded-lg border border-[#EADFC9] p-8 md:p-10 flex flex-col justify-between shadow-sm hover:border-[var(--color-ykb-orange)] transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-orange-100 text-[var(--color-ykb-orange)]">
                South Chapter
              </span>
              <span class="text-xs font-semibold text-slate-400">YKB South</span>
            </div>

            <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#2B2317]">
              YKB South
            </h2>

            <p class="mt-4 text-slate-600 leading-7 text-sm md:text-base">
              Funds local community initiatives, food drives, and youth engagement programs organized by the
              brothers of the YKB South chapter.
            </p>

            <ul class="mt-6 space-y-2.5 text-xs text-slate-600 font-medium border-t border-[#F2ECE1] pt-5">
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-ykb-orange)] font-bold">✓</span> Regional service projects and outreach
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-ykb-orange)] font-bold">✓</span> Brotherhood and mentorship events
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-ykb-orange)] font-bold">✓</span> Grassroots community impact
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-[#F2ECE1]">
            <a
              href="https://givebutter.com/young-khalsa-boys-fundraiser-bq2wmc"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 rounded-md bg-[var(--color-ykb-blue)] px-6 py-3.5 text-sm font-bold text-white shadow-sm transition-colors hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-ykb-blue/40"
            >
              Donate to YKB South
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

      </div>

    </section>

    <!-- IMPACT NOTE -->
    <section class="border-t border-[#EADFC9] bg-[#FFFDF9] py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-5 sm:px-8 text-center">
        <h3 class="text-2xl md:text-3xl font-serif font-bold text-[#2B2317]">
          Where Your Donation Goes
        </h3>
        <p class="mt-4 text-base text-slate-600 leading-7 max-w-2xl mx-auto">
          Young Khalsa Boys is run by youth for the community. 100% of public contributions go directly towards
          purchasing groceries, supplies for families in need, and organizing community seva drives.
        </p>
      </div>
    </section>

  </div>
</Layout>
