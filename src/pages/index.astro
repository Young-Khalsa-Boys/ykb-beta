---
import Layout from '../layouts/Layout.astro';
import heroBg from '../assets/herosectionbg.jpeg';

import { Image } from 'astro:assets';
import fcw1 from '../assets/fundraisers/car-wash/ykb_fcw_1-grouppic1.jpg';
import fcw7 from '../assets/fundraisers/car-wash/ykb_fcw_7-chryslerwash.jpg';
import fcw3 from '../assets/fundraisers/car-wash/ykb_fcw_3-gurudwaraspeech.jpg';
import c0 from '../assets/photocarousel/ykb_c0-lunch.jpeg';

const carouselPhotos = [
  fcw1,
  fcw7,
  fcw3,
  c0,
];

const actionLinks = [
  { title: 'About', href: '/about', color: '#50AD21', action: 'About Us' },
  { title: 'Members', href: '/members', color: '#FF7E25', action: 'Meet the Team' },
  { title: 'Projects', href: '/projects', color: '#0756A1', action: 'Our Work' },
  { title: 'Fundraisers', href: '/fundraisers', color: '#50AD21', action: 'Events & Drives' },
  {
    title: 'Donate',
    href: 'https://givebutter.com/young-khalsa-boys-fundraiser-bq2wmc',
    external: true,
    color: '#FF7E25',
    action: 'Support Seva',
  },
];

import { getImage } from 'astro:assets';

const optimizedHeroBg = await getImage({ src: heroBg, format: 'webp', width: 1600 });
const heroBgUrl = optimizedHeroBg.src;
---

<Layout title="Young Khalsa Boys">
  <div class="w-full bg-[#FAF6EE]">

    <!-- HERO -->
    <section class="relative h-[620px] md:h-[680px] overflow-hidden bg-[#19221C]">

      <img
        src={heroBgUrl}
        alt="Young Khalsa Boys"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />

      <!-- Soft bottom gradient treatment so text is legible and photograph remains visible -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#19221C]/90 via-[#19221C]/35 to-black/20"></div>

      <div class="relative z-10 h-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 flex items-end">

        <!-- Text overlay without box -->
        <div class="mb-10 md:mb-14 max-w-2xl">

          <div class="flex items-center gap-4">

            <img
              src="/logo.png"
              alt="Young Khalsa Boys Logo"
              class="w-14 h-14 md:w-16 md:h-16 object-contain flex-shrink-0 drop-shadow-md"
            />

            <div>
              <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif font-bold text-white leading-tight drop-shadow-md">
                Young Khalsa Boys
              </h1>

              <p class="mt-2 text-sm sm:text-base md:text-lg text-white/90 leading-relaxed drop-shadow max-w-xl">
                A boy-led group focused on serving humanity through
                brotherhood, leadership, humility, and sewa.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- GET INVOLVED -->
    <section class="max-w-6xl mx-auto px-5 sm:px-8 py-14 md:py-16">

      <div class="flex items-end justify-between mb-7">

        <div>
          <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#0756A1] mb-2">
            Young Khalsa Boys
          </p>

          <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#2B2317]">
            Get involved
          </h2>
        </div>

      </div>


      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

        {
          actionLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="group block"
            >
              <div class="relative overflow-hidden aspect-[3/2] sm:aspect-[4/3] lg:aspect-[3/2] bg-[#FFFDF9] border border-[#EADFC9] rounded-sm flex flex-col items-center justify-center p-6 text-center transition-all duration-300 group-hover:border-[#CFC0A2] group-hover:bg-white group-hover:shadow-md group-hover:-translate-y-1">

                <!-- Stripe in YKB colors -->
                <div class="absolute top-0 inset-x-0 h-1.5 flex">
                  <div class="flex-1 bg-[#50AD21]"></div>
                  <div class="flex-1 bg-[#FF7E25]"></div>
                  <div class="flex-1 bg-[#0756A1]"></div>
                </div>

                <p class="text-xl sm:text-2xl font-serif font-bold text-[#2B2317] group-hover:text-[var(--color-ykb-orange)] transition-colors">
                  {link.title}
                </p>

                <p
                  class="mt-2 text-xs font-bold uppercase tracking-[0.14em] transition-colors"
                  style={`color: ${link.color}`}
                >
                  {link.external ? `${link.action} ↗` : `${link.action} →`}
                </p>

              </div>
            </a>
          ))
        }

      </div>

    </section>


    <!-- INTRO -->
    <section class="border-y border-[#EADFC9] bg-[#FFFDF9]">

      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-14 md:py-16">

        <p class="max-w-4xl mx-auto text-center text-xl md:text-2xl font-serif leading-relaxed text-[#2B2317]">
          We empower Sikh boys to grow into compassionate leaders through
          community service initiatives, mentorship, and lasting bonds
          rooted in selfless service.
        </p>

      </div>

    </section>


    <!-- GALLERY -->
    <section class="bg-[#FAF6EE] border-t border-[#EADFC9] py-16 md:py-20">

      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">

        <div class="mb-9">

          <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#0756A1] mb-2">
            Gallery
          </p>

          <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B2317]">
            Moments in Action
          </h2>

        </div>


        <div
          class="relative overflow-hidden group cursor-grab active:cursor-grabbing"
          data-home-carousel
        >

          <div
            class="flex backface-hidden transition-transform duration-700 ease-out"
            data-home-carousel-track
          >

            {
              carouselPhotos.map((photo, index) => (
                <div class="flex-[0_0_100%] min-w-0 md:flex-[0_0_70%] lg:flex-[0_0_60%] px-2">

                  <div class="relative aspect-[16/9] overflow-hidden rounded-xl bg-[#FFFDF9] border border-[#EADFC9] shadow-md">

                    <Image
                      src={photo}
                      width={800}
                      alt={`YKB Gallery ${index + 1}`}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                    />

                  </div>

                </div>
              ))
            }

          </div>

          <div class="hidden md:block absolute top-0 bottom-0 left-0 w-28 md:w-36 bg-gradient-to-r from-[#FAF6EE] to-transparent pointer-events-none z-10"></div>

          <div class="hidden md:block absolute top-0 bottom-0 right-0 w-28 md:w-36 bg-gradient-to-l from-[#FAF6EE] to-transparent pointer-events-none z-10"></div>

        </div>

      </div>

    </section>

  </div>


  <script>
    document.querySelectorAll('[data-home-carousel]').forEach((carousel) => {
      const track = carousel.querySelector('[data-home-carousel-track]');

      if (!track) return;

      const slides = [...track.children];

      if (slides.length < 2) return;

      let activeIndex = 0;

      const updateCarousel = () => {
        const slideWidth = slides[activeIndex].getBoundingClientRect().width;

        track.style.transform =
          `translate3d(-${slideWidth * activeIndex}px, 0, 0)`;
      };

      window.addEventListener('resize', updateCarousel);

      window.setInterval(() => {
        activeIndex = (activeIndex + 1) % slides.length;
        updateCarousel();
      }, 4000);
    });
  </script>
</Layout>