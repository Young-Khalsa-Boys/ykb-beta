---
import Layout from '../layouts/Layout.astro';
import heroBg from '../assets/herosectionbg.jpeg';

const carouselPhotos = [
  '/fundraisers/carwash/ykb_fcw_1-grouppic1.jpg',
  '/fundraisers/carwash/ykb_fcw_7-chryslerwash.jpg',
  '/fundraisers/carwash/ykb_fcw_3-gurudwaraspeech.jpg',
  '/photocarousel/ykb_c0-lunch.jpeg',
];

const actionLinks = [
  { title: 'About', href: '/about' },
  { title: 'Members', href: '/members' },
  { title: 'Projects', href: '/projects' },
  { title: 'Fundraisers', href: '/fundraisers' },
  {
    title: 'Donate',
    href: 'https://givebutter.com/young-khalsa-boys-fundraiser-bq2wmc',
    external: true,
  },
];

const heroBgUrl = heroBg.src;
---

<Layout title="Young Khalsa Boys">
  <div class="w-full bg-[#FAF6EE]">

    <!-- HERO -->
    <section class="relative h-[620px] md:h-[680px] overflow-hidden bg-[#19221C]">

      <img
        src={heroBgUrl}
        alt="Young Khalsa Boys"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />

      <!-- Light overall treatment so the photograph remains visible -->
      <div class="absolute inset-0 bg-[#19221C]/25"></div>

      <div class="relative z-10 h-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 flex items-end">

        <!-- Deliberate solid information panel -->
        <div class="mb-8 md:mb-10 bg-[#19221C]/95 px-6 py-6 md:px-8 md:py-7 max-w-xl">

          <div class="flex items-center gap-4">

            <img
              src="/logo.png"
              alt="Young Khalsa Boys Logo"
              class="w-14 h-14 md:w-16 md:h-16 object-contain flex-shrink-0"
            />

            <div>
              <h1 class="text-3xl md:text-4xl font-serif font-bold text-white leading-tight">
                Young Khalsa Boys
              </h1>

              <p class="mt-2 text-sm md:text-base text-white/75 leading-6">
                A boy-led group focused on serving humanity through
                brotherhood, leadership, humility, and sewa.
              </p>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- GET INVOLVED -->
    <section class="max-w-6xl mx-auto px-5 sm:px-8 py-14 md:py-16">

      <div class="flex items-end justify-between mb-7">

        <div>
          <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#0756A1] mb-2">
            Young Khalsa Boys
          </p>

          <h2 class="text-2xl md:text-3xl font-serif font-bold text-[#2B2317]">
            Get involved
          </h2>
        </div>

      </div>


      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">

        {
          actionLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="group block"
            >
              <div class="aspect-[3/2] bg-[#FFFDF9] border border-[#EADFC9] flex flex-col items-center justify-center p-7 transition-all duration-300 group-hover:border-[#CFC0A2] group-hover:bg-white">

                <img
                  src="/logo.png"
                  alt="YKB Logo"
                  class="h-24 w-auto object-contain opacity-90 transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />

                <p class="mt-4 text-center text-xs font-bold uppercase tracking-[0.16em] text-[#2B2317] group-hover:text-[var(--ykb-orange)] transition-colors">
                  {link.title}
                </p>

              </div>
            </a>
          ))
        }

      </div>

    </section>


    <!-- INTRO -->
    <section class="border-y border-[#EADFC9] bg-[#FFFDF9]">

      <div class="max-w-6xl mx-auto px-5 sm:px-8 py-14 md:py-16">

        <p class="max-w-4xl mx-auto text-center text-xl md:text-2xl font-serif leading-relaxed text-[#2B2317]">
          We empower Sikh boys to grow into compassionate leaders through
          community service initiatives, mentorship, and lasting bonds
          rooted in selfless service.
        </p>

      </div>

    </section>


    <!-- GALLERY -->
    <section class="bg-[#26342B] py-16 md:py-20">

      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">

        <div class="mb-9">

          <p class="text-xs font-bold uppercase tracking-[0.15em] text-[var(--ykb-orange)] mb-3">
            Gallery
          </p>

          <h2 class="text-3xl md:text-4xl font-serif font-bold text-white">
            Moments in Action
          </h2>

        </div>


        <div
          class="relative overflow-hidden group cursor-grab active:cursor-grabbing"
          data-home-carousel
        >

          <div
            class="flex backface-hidden transition-transform duration-700 ease-out"
            data-home-carousel-track
          >

            {
              carouselPhotos.map((photo, index) => (
                <div class="flex-[0_0_100%] min-w-0 md:flex-[0_0_70%] lg:flex-[0_0_60%] px-2">

                  <div class="relative aspect-[16/9] overflow-hidden bg-[#19221C]">

                    <img
                      src={photo}
                      alt={`YKB Gallery ${index + 1}`}
                      class="absolute inset-0 w-full h-full object-cover"
                      loading="lazy"
                    />

                  </div>

                </div>
              ))
            }

          </div>

          <div class="hidden md:block absolute top-0 bottom-0 left-0 w-32 bg-gradient-to-r from-[#26342B] to-transparent pointer-events-none"></div>

          <div class="hidden md:block absolute top-0 bottom-0 right-0 w-32 bg-gradient-to-l from-[#26342B] to-transparent pointer-events-none"></div>

        </div>

      </div>

    </section>

  </div>


  <script>
    document.querySelectorAll('[data-home-carousel]').forEach((carousel) => {
      const track = carousel.querySelector('[data-home-carousel-track]');

      if (!track) return;

      const slides = [...track.children];

      if (slides.length < 2) return;

      let activeIndex = 0;

      const updateCarousel = () => {
        const slideWidth = slides[activeIndex].getBoundingClientRect().width;

        track.style.transform =
          `translate3d(-${slideWidth * activeIndex}px, 0, 0)`;
      };

      window.addEventListener('resize', updateCarousel);

      window.setInterval(() => {
        activeIndex = (activeIndex + 1) % slides.length;
        updateCarousel();
      }, 4000);
    });
  </script>
</Layout>