---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Members - Young Khalsa Boys">
  <div class="min-h-screen bg-[#FAF6EE] pt-20 pb-24">
  <div class="mb-16 text-center max-w-3xl mx-auto px-4 mt-8">
    <h1 class="text-4xl font-serif font-bold text-[#2B2317] mb-4">Our Members</h1>
    <p class="text-lg text-slate-700 font-sans">
      Meet the dedicated young men who make our Seva possible. A brotherhood committed to community service.
    </p>
  </div>

  <div class="max-w-md mx-auto px-4 text-center py-12">
    <div class="bg-[#FFFDF9] border border-[#EADFC9] rounded-lg py-12 px-6 shadow-sm font-serif font-bold text-xl text-[var(--ykb-orange)] tracking-widest">
      COMING SOON!!!
    </div>
  </div>
  </div>
</Layout>
