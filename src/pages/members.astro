---
import Layout from '../layouts/Layout.astro';
import type { ImageMetadata } from 'astro';

const profileImagesGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/profilePictures/**/*.{jpeg,jpg,png,webp,gif}', { eager: true });

const getProfileImage = (filename: string | null) => {
  if (!filename) return null;
  const key = `/src/assets/profilePictures/${filename}`;
  return profileImagesGlob[key]?.default?.src || null;
};

const leadership = [
  {
    name: 'Shahan Arora',
    role: 'Founder & Assistant Treasurer',
    image: getProfileImage('YKB_Shahan.jpg'),
    bio: 'Shahan is the founder of Young Khalsa Boys and has been serving the community since YKB\'s founding. He is passionate about leadership, mentorship, and creating opportunities for young boys to grow through seva.',
  },
  {
    name: 'Kabir Sekhon',
    role: 'Director of Technology',
    image: getProfileImage('YKB_Kabir.jpg'),
    bio: 'Kabir is the Director of Technology for Young Khalsa Boys and is responsible for managing the organization\'s digital presence and technological infrastructure.',
  },
];

const ykbMembers = [
  { name: 'Suvir Sekhon', image: getProfileImage('YKB_Suvir.jpg') },
  { name: 'Ajeet Singh', image: getProfileImage('YKB_Ajeet.jpg') },
  { name: 'Zoravar Malik', image: getProfileImage('YKB_Zorawar.jpg') },
  { name: 'Jeevat Sethi', image: null },
  { name: 'Aaryav Saluja', image: getProfileImage('YKB_Aaryav.jpg') },
  { name: 'Subhaig Singh', image: getProfileImage('YKB_Subhaig.jpg') },
  { name: 'Tegh Garcha', image: null },
  { name: 'Jodh Saluja', image: null },
  { name: 'Naveen Malik', image: getProfileImage('YKB_Naveen.jpg') },
  { name: 'Karanbir Singh', image: null },
];

const ykbSouthMembers = [
  { name: 'Jugaad Singh Sodhi', image: null },
  { name: 'VeerPartap Singh Chawla', image: null },
  { name: 'Rajinder Pal Singh Chawla', image: null },
  { name: 'Krishpreet Singh Basra', image: null },
  { name: 'Jaskeerat Singh Baweja', image: null },
  { name: 'Arjan Santokh Singh Arora', image: null },
  { name: 'Sahib Singh Varaich', image: null },
  { name: 'Damanjit Singh', image: null },
];
---

<Layout title="Members - Young Khalsa Boys">
  <div class="min-h-screen bg-[#FAF6EE]">

    <!-- INTRO -->
    <section class="border-b border-[#EADFC9]">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-ykb-blue)] mb-4">
          Our Members
        </p>

        <div class="max-w-3xl">
          <h1 class="text-4xl md:text-6xl font-serif font-bold text-[#2B2317] leading-[1.05]">
            The Brotherhood
          </h1>

          <p class="mt-6 text-lg md:text-xl text-slate-600 leading-8 max-w-2xl">
            Young Khalsa Boys is built by the boys who show up, serve their
            communities, and grow together through seva, leadership, and
            brotherhood across our chapters.
          </p>

          <!-- Quick Navigation Anchor Links -->
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="#young-khalsa-boys"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-white border border-[#EADFC9] text-slate-700 hover:border-[var(--color-ykb-blue)] hover:text-[var(--color-ykb-blue)] transition-colors shadow-sm"
            >
              <span class="w-2 h-2 rounded-full bg-[var(--color-ykb-blue)]"></span>
              Young Khalsa Boys
            </a>
            <a
              href="#ykb-south"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-white border border-[#EADFC9] text-slate-700 hover:border-[var(--color-ykb-orange)] hover:text-[var(--color-ykb-orange)] transition-colors shadow-sm"
            >
              <span class="w-2 h-2 rounded-full bg-[var(--color-ykb-orange)]"></span>
              YKB South
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION: YOUNG KHALSA BOYS -->
    <div id="young-khalsa-boys" class="scroll-mt-20">

      <!-- LEADERSHIP -->
      <section class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

        <div class="flex items-end justify-between border-b border-[#EADFC9] pb-5 mb-10">
          <div>
            <span class="inline-block px-2.5 py-1 rounded text-[11px] font-bold uppercase tracking-wider bg-blue-100/80 text-[var(--color-ykb-blue)] mb-3">
              Young Khalsa Boys Chapter
            </span>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-ykb-orange)] mb-2">
              Leadership
            </p>
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B2317]">
              Leading through seva
            </h2>
          </div>
        </div>

        {
          leadership.length > 0 && (
            <div class="grid md:grid-cols-2 gap-x-10 gap-y-12">
              {leadership.map((member) => (
                <article class="grid grid-cols-[120px_1fr] md:grid-cols-[160px_1fr] gap-6 items-start">
                  <div class="aspect-square overflow-hidden bg-[#E7DED0] rounded-sm">
                    {member.image ? (
                      <img
                        src={member.image}
                        alt={member.name}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center">
                        <span class="text-3xl font-serif font-bold text-[#C5B9A6]">
                          {member.name.charAt(0)}
                        </span>
                      </div>
                    )}
                  </div>

                  <div class="pt-1">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--color-ykb-blue)]">
                      {member.role}
                    </p>

                    <h3 class="mt-2 text-2xl font-serif font-bold text-[#2B2317]">
                      {member.name}
                    </h3>

                    {member.bio && (
                      <p class="mt-3 text-sm text-slate-600 leading-6">
                        {member.bio}
                      </p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          )
        }

      </section>

      <!-- YKB MEMBERS -->
      <section class="bg-[#FFFDF9] border-y border-[#EADFC9]">
        <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

          <div class="mb-10">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-ykb-green)] mb-2">
              Young Khalsa Boys
            </p>
            <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B2317]">
              Chapter Members
            </h2>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-6 gap-y-10">
            {ykbMembers.map((member) => (
              <article class="group">
                <div class="aspect-square overflow-hidden bg-[#E7DED0] rounded-sm transition-transform duration-200 group-hover:scale-[1.02]">
                  {member.image ? (
                    <img
                      src={member.image}
                      alt={member.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <span class="text-3xl font-serif font-bold text-[#C5B9A6]">
                        {member.name.charAt(0)}
                      </span>
                    </div>
                  )}
                </div>

                <div class="pt-3">
                  <h3 class="font-serif font-bold text-lg text-[#2B2317]">
                    {member.name}
                  </h3>
                </div>
              </article>
            ))}
          </div>

        </div>
      </section>

    </div>


    <!-- SECTION: YKB SOUTH -->
    <div id="ykb-south" class="scroll-mt-20">

      <section class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10 py-16 md:py-20">

        <div class="border-b border-[#EADFC9] pb-5 mb-10">
          <span class="inline-block px-2.5 py-1 rounded text-[11px] font-bold uppercase tracking-wider bg-orange-100/80 text-[var(--color-ykb-orange)] mb-3">
            South Chapter
          </span>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-ykb-orange)] mb-2">
            YKB South
          </p>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B2317]">
            South Chapter Members
          </h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-x-6 gap-y-10">
          {ykbSouthMembers.map((member) => (
            <article class="group">
              <div class="aspect-square overflow-hidden bg-[#E7DED0] rounded-sm transition-transform duration-200 group-hover:scale-[1.02]">
                {member.image ? (
                  <img
                    src={member.image}
                    alt={member.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <span class="text-3xl font-serif font-bold text-[#C5B9A6]">
                      {member.name.charAt(0)}
                    </span>
                  </div>
                )}
              </div>

              <div class="pt-3">
                <h3 class="font-serif font-bold text-lg text-[#2B2317]">
                  {member.name}
                </h3>
              </div>
            </article>
          ))}
        </div>

      </section>

    </div>


    <!-- CLOSING -->
    <section class="border-t border-[#EADFC9] max-w-4xl mx-auto px-5 sm:px-8 py-20 md:py-24 text-center">

      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--color-ykb-orange)] mb-4">
        Brotherhood through seva
      </p>

      <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#2B2317]">
        We serve together.
      </h2>

      <p class="mt-5 text-lg text-slate-600 leading-8 max-w-2xl mx-auto">
        Every project is an opportunity to serve our community, learn from
        one another, and grow into better leaders.
      </p>

    </section>

  </div>
</Layout>
